OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/openai/gpt-5-mini

SUBNET_CLAIMS_AGENT_PROVIDER=openrouter
SUBNET_CLAIMS_AGENT_MODEL=openrouter/openai/gpt-5-mini
SUBNET_CLAIMS_AGENT_HARNESS=staged
SUBNET_CLAIMS_AGENT_RUNTIME=staged
SUBNET_CLAIMS_AGENT_MAX_ITERS=8
SUBNET_CLAIMS_AGENT_MAX_TOKENS=
SUBNET_CLAIMS_AGENT_TEMPERATURE=1.0
SUBNET_CLAIMS_AGENT_TIMEOUT=3600
SUBNET_CLAIMS_AGENT_MAX_REPAIR_ATTEMPTS=3
SUBNET_CLAIMS_PDF_READER=pdf-inspector
SUBNET_CLAIMS_AGENT_MAX_SOURCE_CHARS=400000

DSPY_CACHEDIR=/tmp/dspy_cache_claims_gpt5_mini
LITELLM_CACHE=False

CLAIMS_BACKEND_URL=https://artifacts.claims111.ai
CLAIMS_BACKEND_TIMEOUT=120
CLAIMS_BACKEND_RETRIES=3
CLAIMS_MINER_BATCH_MAX_WORKERS=8

# Type your registered SN111 wallet names here before starting PM2.
BT_WALLET_NAME=   # set for your machine
BT_WALLET_HOTKEY=
BT_NETUID=111
BT_SUBTENSOR_NETWORK=finney
BT_AXON_IP=0.0.0.0
BT_AXON_EXTERNAL_IP=   # set for your machine
BT_AXON_PORT=8091
BT_AXON_EXTERNAL_PORT=8091
CLAIMS_MINER_OUTPUT_DIR=runs/neuron/mainnet

# --- staged (coverage-first) runtime ---------------------------------------
# Per-stage model overrides (default: SUBNET_CLAIMS_AGENT_MODEL). OpenRouter ids.
SUBNET_CLAIMS_STAGED_EXTRACT_MODEL=
SUBNET_CLAIMS_STAGED_CONSOLIDATE_MODEL=
SUBNET_CLAIMS_STAGED_STRUCTURE_MODEL=
# Parallel span extractions per paper. Total in-flight provider calls = this x CLAIMS_MINER_BATCH_MAX_WORKERS
# (4 x 8 = 32 on mainnet). Raise only if the provider tolerates it.
SUBNET_CLAIMS_STAGED_EXTRACT_CONCURRENCY=4
# Reasoning effort per stage for reasoning models (low|medium|high|none).
SUBNET_CLAIMS_STAGED_EXTRACT_REASONING_EFFORT=low
SUBNET_CLAIMS_STAGED_CONSOLIDATE_REASONING_EFFORT=low
SUBNET_CLAIMS_STAGED_STRUCTURE_REASONING_EFFORT=low
SUBNET_CLAIMS_STAGED_REQUEST_TIMEOUT=300
# Local self-judge (tools/evaluate.py --judge)
SUBNET_CLAIMS_JUDGE_MODEL=openrouter/openai/gpt-5-mini
SUBNET_CLAIMS_JUDGE_REASONING_EFFORT=medium
